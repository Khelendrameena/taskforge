# Copy to .env and adjust. No secrets here -- Redis has no auth in dev.
REDIS_URL=redis://localhost:6379/0
TASKFORGE_NAMESPACE=tf

# Worker tuning
TASKFORGE_WORKER_CONCURRENCY=4
TASKFORGE_VISIBILITY_TIMEOUT_S=30
TASKFORGE_SWEEP_INTERVAL_S=5
TASKFORGE_POLL_INTERVAL_S=0.05

# Retry backoff: delay = min(cap, base * 2**attempt) + jitter
TASKFORGE_RETRY_BASE_S=1.0
TASKFORGE_RETRY_CAP_S=60.0

# How long producer idempotency keys are remembered
TASKFORGE_IDEMPOTENCY_TTL_S=86400

TASKFORGE_LOG_LEVEL=INFO
DEMO_API_PORT=8080
